<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.SplitPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.ToggleButton?>
<?import javafx.scene.control.ToggleGroup?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<SplitPane dividerPositions="0.4" prefHeight="500.0" prefWidth="800.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="guessmarket.javafx.ui.EventsViewController">
   <items>
      <!-- LEFT SIDE: Filters and Event List -->
      <ScrollPane fitToWidth="true" fitToHeight="true">
      <VBox spacing="10.0" style="-fx-padding: 10;">
         <VBox spacing="5.0">
             <HBox spacing="10.0" alignment="CENTER_LEFT">
                <Label text="Type:" prefWidth="60"/>
                <ToggleButton fx:id="filterAllTypeBtn" text="All" selected="true" onAction="#handleFilterChange">
                   <toggleGroup><ToggleGroup fx:id="typeGroup"/></toggleGroup>
                </ToggleButton>
                <ToggleButton fx:id="filterLMSRBtn" text="LMSR" toggleGroup="$typeGroup" onAction="#handleFilterChange" />
                <ToggleButton fx:id="filterOBBtn" text="Order Book" toggleGroup="$typeGroup" onAction="#handleFilterChange" />
             </HBox>
             <HBox spacing="10.0" alignment="CENTER_LEFT">
                <Label text="Status:" prefWidth="60"/>
                <ToggleButton fx:id="filterAllStatusBtn" text="All" selected="true" onAction="#handleFilterChange">
                   <toggleGroup><ToggleGroup fx:id="statusGroup"/></toggleGroup>
                </ToggleButton>
                <ToggleButton fx:id="filterNotStartedBtn" text="Not Started" toggleGroup="$statusGroup" onAction="#handleFilterChange" />
                <ToggleButton fx:id="filterActiveBtn" text="Active" toggleGroup="$statusGroup" onAction="#handleFilterChange" />
                <ToggleButton fx:id="filterEndedBtn" text="Ended" toggleGroup="$statusGroup" onAction="#handleFilterChange" />
             </HBox>
             <HBox spacing="10.0" alignment="CENTER_LEFT">
                <Label text="Commission:" prefWidth="60"/>
                <ToggleButton fx:id="filterAllCommBtn" text="All" selected="true" onAction="#handleFilterChange">
                   <toggleGroup><ToggleGroup fx:id="commGroup"/></toggleGroup>
                </ToggleButton>
                <ToggleButton fx:id="filterOnPurchaseBtn" text="On Purchase" toggleGroup="$commGroup" onAction="#handleFilterChange" />
                <ToggleButton fx:id="filterOnCloseBtn" text="On Close" toggleGroup="$commGroup" onAction="#handleFilterChange" />
             </HBox>
         </VBox>
         <TableView fx:id="eventsTable" VBox.vgrow="ALWAYS">
             <columns>
                 <TableColumn fx:id="idColumn" text="ID" prefWidth="50" />
                 <TableColumn fx:id="nameColumn" text="Name" prefWidth="150" />
                 <TableColumn fx:id="statusColumn" text="Status" prefWidth="75" />
                 <TableColumn fx:id="commissionColumn" text="Commission" prefWidth="100" />
             </columns>
             <placeholder><Label text="No events to display"/></placeholder>
         </TableView>
      </VBox>
      </ScrollPane>

      <!-- RIGHT SIDE: Details (browse-only - trading/start/close happens from the Users screen) -->
      <fx:include fx:id="eventDetail" source="event_detail.fxml"/>
   </items>
</SplitPane>
