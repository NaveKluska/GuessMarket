<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.chart.LineChart?>
<?import javafx.scene.chart.NumberAxis?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.SplitPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<ScrollPane fitToWidth="true" fitToHeight="true" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="guessmarket.javafx.ui.UsersViewController">
<SplitPane dividerPositions="0.3" prefHeight="500.0" prefWidth="800.0">
   <items>
      <!-- LEFT SIDE: Users Table -->
      <VBox spacing="10.0" style="-fx-padding: 10;">
         <Label text="Users Table" style="-fx-font-size: 16px; -fx-font-weight: bold;" />
         <TableView fx:id="usersTable" VBox.vgrow="ALWAYS">
             <columns>
                 <TableColumn fx:id="userNameColumn" text="Name" prefWidth="150" />
                 <TableColumn fx:id="userBalanceColumn" text="Balance" prefWidth="100" />
             </columns>
             <placeholder><Label text="No users loaded"/></placeholder>
         </TableView>
      </VBox>

      <!-- RIGHT SIDE: Selected user's info, then pick an event to manage/trade as them -->
      <SplitPane dividerPositions="0.4" orientation="VERTICAL">
        <items>
          <VBox spacing="10.0" style="-fx-padding: 10;">
             <HBox spacing="10.0" alignment="CENTER_LEFT">
                 <Label text="Single User Details" style="-fx-font-size: 18px; -fx-font-weight: bold;" HBox.hgrow="ALWAYS" maxWidth="Infinity" />
                 <Button text="Add Funds" onAction="#handleAddFunds" style="-fx-base: magenta; -fx-text-fill: white;" />
                 <!-- Bonus: Create Event (creator becomes its Market Maker) -->
                 <Button text="Create Event" onAction="#handleCreateEvent" style="-fx-base: lightgreen;" />
             </HBox>

             <Label fx:id="selectedUserNameLabel" text="Select a user..." style="-fx-font-size: 14px;" />
             <Label fx:id="selectedUserBalanceLabel" text="Balance: N/A" />
             <Label fx:id="selectedUserMarketMakerLabel" text="" style="-fx-text-fill: darkorange; -fx-font-style: italic;" />

             <!-- Balance History Chart -->
             <VBox style="-fx-border-color: gray; -fx-padding: 5;" VBox.vgrow="ALWAYS" prefHeight="140.0">
                 <Label text="Balance History" alignment="CENTER" maxWidth="Infinity" style="-fx-font-weight: bold;"/>
                 <LineChart fx:id="balanceChart" createSymbols="false" VBox.vgrow="ALWAYS" animated="false">
                   <xAxis><NumberAxis side="BOTTOM" label="Trade #"/></xAxis>
                   <yAxis><NumberAxis side="LEFT" label="Balance ($)"/></yAxis>
                 </LineChart>
             </VBox>

             <SplitPane VBox.vgrow="ALWAYS">
               <items>
                 <VBox style="-fx-border-color: gray; -fx-padding: 5;">
                     <Label text="My Holdings / Participations" alignment="CENTER" maxWidth="Infinity"/>
                     <TableView fx:id="portfolioTable" VBox.vgrow="ALWAYS">
                         <columns>
                             <TableColumn fx:id="portfolioEventColumn" text="Event ID" prefWidth="75"/>
                             <TableColumn fx:id="portfolioOptionColumn" text="Option" prefWidth="100"/>
                             <TableColumn fx:id="portfolioQuantityColumn" text="Quantity" prefWidth="75"/>
                         </columns>
                         <placeholder><Label text="No participations"/></placeholder>
                     </TableView>
                 </VBox>
                 <VBox style="-fx-border-color: gray; -fx-padding: 5;">
                     <Label text="All Events (select one to manage/trade as this user)" alignment="CENTER" maxWidth="Infinity"/>
                     <TableView fx:id="allEventsTable" VBox.vgrow="ALWAYS">
                         <columns>
                             <TableColumn fx:id="aeIdColumn" text="ID" prefWidth="50"/>
                             <TableColumn fx:id="aeNameColumn" text="Name" prefWidth="150"/>
                             <TableColumn fx:id="aeStatusColumn" text="Status" prefWidth="75"/>
                             <TableColumn fx:id="aeCommissionColumn" text="Commission" prefWidth="100"/>
                         </columns>
                         <placeholder><Label text="No events loaded"/></placeholder>
                     </TableView>
                 </VBox>
               </items>
             </SplitPane>
          </VBox>

          <!-- Selected event's details, trading and Start/Close controls, acting as the selected user -->
          <fx:include fx:id="eventDetail" source="event_detail.fxml"/>
        </items>
      </SplitPane>
   </items>
</SplitPane>
</ScrollPane>
