<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.ProgressBar?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.SplitPane?>
<?import javafx.scene.control.Tab?>
<?import javafx.scene.control.TabPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="guessmarket.javafx.ui.MainController" styleClass="app-root">

    <top>
        <HBox styleClass="toolbar" spacing="10" alignment="CENTER_LEFT">
            <padding><Insets top="10" right="16" bottom="10" left="16"/></padding>
            <Label text="Guess Market" styleClass="brand-title"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Label fx:id="filePathLabel" text="No file loaded" styleClass="filepath-label"/>
            <ProgressBar fx:id="loadProgressBar" progress="0" visible="false" managed="false"/>
            <Button fx:id="loadFileButton" text="Load File..." styleClass="primary-button"/>
        </HBox>
    </top>

    <center>
        <TabPane fx:id="mainTabPane" tabClosingPolicy="UNAVAILABLE" styleClass="main-tabs">

            <Tab text="Events">
                <VBox>
                    <HBox styleClass="filter-bar" spacing="14" alignment="CENTER_LEFT">
                        <padding><Insets top="10" right="16" bottom="10" left="16"/></padding>
                        <VBox spacing="3">
                            <Label text="METHOD" styleClass="filter-label"/>
                            <ComboBox fx:id="methodFilterCombo" />
                        </VBox>
                        <VBox spacing="3">
                            <Label text="STATUS" styleClass="filter-label"/>
                            <ComboBox fx:id="statusFilterCombo" />
                        </VBox>
                        <VBox spacing="3">
                            <Label text="COMMISSION" styleClass="filter-label"/>
                            <ComboBox fx:id="commissionFilterCombo" />
                        </VBox>
                    </HBox>

                    <SplitPane dividerPositions="0.32" VBox.vgrow="ALWAYS">
                        <ListView fx:id="eventListView" />
                        <ScrollPane fitToWidth="true" styleClass="detail-scroll">
                            <VBox fx:id="eventDetailPane" styleClass="detail-pane">
                                <Label text="Select an event to see its details." styleClass="placeholder-label"/>
                            </VBox>
                        </ScrollPane>
                    </SplitPane>
                </VBox>
            </Tab>

            <Tab text="Users">
                <SplitPane dividerPositions="0.28">
                    <ListView fx:id="userListView" />
                    <ScrollPane fitToWidth="true" styleClass="detail-scroll">
                        <VBox fx:id="userDetailPane" styleClass="detail-pane">
                            <Label text="Select a user to see their details." styleClass="placeholder-label"/>
                        </VBox>
                    </ScrollPane>
                </SplitPane>
            </Tab>

        </TabPane>
    </center>

</BorderPane>
