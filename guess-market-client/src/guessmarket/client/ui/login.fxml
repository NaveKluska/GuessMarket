<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="guessmarket.client.ui.LoginController" styleClass="login-root"
           stylesheets="@app.css">

    <VBox alignment="CENTER" spacing="14" styleClass="login-card">
        <padding><Insets top="36" right="36" bottom="36" left="36"/></padding>

        <Label text="Guess Market" styleClass="login-title"/>
        <Label text="Enter a name to continue." styleClass="login-subtitle" wrapText="true"/>

        <TextField fx:id="nameField" promptText="Your name"/>
        <Button fx:id="continueButton" text="Continue" maxWidth="Infinity" defaultButton="true" styleClass="primary-button"/>
        <Label fx:id="statusLabel" styleClass="login-error" wrapText="true"/>
    </VBox>

</StackPane>
