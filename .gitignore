# Compiled class files
*.class

# IntelliJ build output
/out/
**/out/

# IntelliJ user-specific files (safe to ignore, machine-specific)
.idea/workspace.xml
.idea/usage.statistics.xml
.idea/shelf/

# Logs
*.log

# OS files
.DS_Store
Thumbs.db

# Office lock/temp files (created by Word/PowerPoint while a doc is open)
~$*

# Scratch javac argfiles - regenerated on demand, contain absolute machine paths
sources_*.txt

# Tomcat runtime output - regenerated fresh every startup, not project state
apache-tomcat-10.1.26/logs/
apache-tomcat-10.1.26/temp/
apache-tomcat-10.1.26/work/

# Deployed WAR and its auto-exploded copy - test-deployment output, not project state
apache-tomcat-10.1.26/webapps/guessmarket.war
apache-tomcat-10.1.26/webapps/guessmarket/

# WAR build output - regenerated by build-war.sh, not project state
guess-market-server/build/

# Scratch compile output used to smoke-test the client, not project state
guess-market-client/build/
