<?xml version="1.0" encoding="UTF-8"?>
<Guess-Market xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="GM-EX1-schema.xsd">
    <GM-events>
        <GM-event name="Rain Tomorrow">
            <id>1</id>
            <description>Will it rain in Tel Aviv tomorrow?</description>
            <comision type="on-purchase">10</comision>
            <GM-options>
                <GM-option>Yes</GM-option>
                <GM-option>No</GM-option>
            </GM-options>
            <GM-method>
                <GM-LMSR>
                    <b>150</b>
                </GM-LMSR>
            </GM-method>
        </GM-event>
        <GM-event name="Broken Liquidity Event">
            <id>2</id>
            <description>This event has an invalid b value of zero</description>
            <comision type="on-close">20</comision>
            <GM-options>
                <GM-option>Yes</GM-option>
                <GM-option>No</GM-option>
            </GM-options>
            <GM-method>
                <GM-LMSR>
                    <b>0</b>
                </GM-LMSR>
            </GM-method>
        </GM-event>
    </GM-events>
</Guess-Market>
